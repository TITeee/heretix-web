---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    date: Date;
  };
}

const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL;
const date = new Date(frontmatter.date);
const dateLabel = date.toISOString().slice(0, 10);
---

<BaseLayout title={`${frontmatter.title} | heretix`} description={frontmatter.description}>
  <Header />
  <main class="px-4 pt-28 pb-24">
    <article class="max-w-2xl mx-auto">
      <a href={`${base}/blog`} class="font-mono text-xs text-ink-mute hover:text-accent transition-colors">&larr; Blog</a>
      <h1 class="text-3xl sm:text-4xl font-semibold text-ink tracking-tight mt-6 mb-3">{frontmatter.title}</h1>
      <p class="text-ink-dim leading-relaxed mb-2">{frontmatter.description}</p>
      <time datetime={dateLabel} class="font-mono text-xs text-ink-mute">{dateLabel}</time>
      <div class="post mt-10">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: string;
  /** Path (relative to base) that this page should be treated as canonical for, e.g. "/en/". */
  canonicalPath: string;
}

const { title, description, lang, canonicalPath } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalHref = new URL(`${base}${canonicalPath}`, Astro.site).toString();
const enHref = new URL(`${base}/en/`, Astro.site).toString();
const jaHref = new URL(`${base}/ja/`, Astro.site).toString();
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="ja" href={jaHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
  </head>
  <body class="bg-linear-to-r from-gray-700 to-gray-950 text-gray-100 antialiased">
    <slot />
  </body>
</html>

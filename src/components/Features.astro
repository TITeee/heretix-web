---
import { en as t } from '../i18n/en';

const columns = [
  {
    label: 'Scanning',
    items: [
      { title: t.feature1Title, desc: t.feature1Desc },
      { title: t.feature7Title, desc: t.feature7Desc },
      { title: t.feature9Title, desc: t.feature9Desc },
      { title: t.feature12Title, desc: t.feature12Desc },
    ],
  },
  {
    label: 'Data & prioritization',
    items: [
      { title: t.feature2Title, desc: t.feature2Desc },
      { title: t.feature3Title, desc: t.feature3Desc },
      { title: t.feature4Title, desc: t.feature4Desc },
      { title: t.feature5Title, desc: t.feature5Desc },
      { title: t.feature11Title, desc: t.feature11Desc },
    ],
  },
  {
    label: 'Console',
    items: [
      { title: t.feature6Title, desc: t.feature6Desc },
      { title: t.feature8Title, desc: t.feature8Desc },
      { title: t.feature10Title, desc: t.feature10Desc },
    ],
  },
];
---

<section class="py-20 px-4">
  <div class="max-w-6xl mx-auto">
    <div class="mb-12">
      <div class="font-mono text-xs font-medium tracking-[0.14em] uppercase text-accent mb-3">Capabilities</div>
      <h2 class="text-3xl sm:text-4xl font-semibold text-ink tracking-tight">{t.featuresTitle}</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-10">
      {columns.map((col) => (
        <div>
          <div class="font-mono text-[11px] tracking-wide uppercase text-ink-mute mb-4">{col.label}</div>
          {col.items.map((item, i) => (
            <div class:list={["flex gap-2.5 py-4", i < col.items.length - 1 && "border-b border-line-soft"]}>
              <span class="font-mono text-sm text-accent shrink-0">&#9656;</span>
              <div>
                <div class="text-sm font-semibold text-ink mb-1">{item.title}</div>
                <div class="text-[13px] leading-relaxed text-ink-dim">{item.desc}</div>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

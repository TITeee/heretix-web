---
import { en as t } from '../i18n/en';

const base = import.meta.env.BASE_URL;

const shots = [
  { src: 'dashboard.png', caption: t.showcaseCaptionDashboard },
  { src: 'alerts.png', caption: t.showcaseCaptionAlerts },
  { src: 'alert-details.png', caption: t.showcaseCaptionAlertsDetail },
  { src: 'assets.png', caption: t.showcaseCaptionAssets },
];
---

<section class="py-20 px-4 border-y border-line bg-bg-raised">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl sm:text-4xl font-semibold text-ink tracking-tight text-center mb-4">{t.showcaseTitle}</h2>
    <p class="text-ink-dim text-center max-w-3xl mx-auto mb-12 leading-relaxed">{t.showcaseSubtitle}</p>
    <div class="max-w-4xl mx-auto grid sm:grid-cols-2 gap-5">
      {shots.map(({ src, caption }) => (
        <figure class="flex flex-col">
          <button
            class="lightbox-trigger rounded-lg overflow-hidden border border-line hover:border-line-strong transition-colors cursor-pointer"
            data-src={`${base}/${src}`}
            aria-label={caption}
          >
            <img src={`${base}/${src}`} alt={caption} class="w-full h-auto block" loading="lazy" />
          </button>
          <figcaption class="text-ink-mute text-xs mt-2 px-1">{caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- Lightbox dialog -->
<dialog
  id="lightbox"
  class="bg-transparent backdrop:bg-black/80 p-0 max-w-5xl w-full mx-auto my-auto"
>
  <img id="lightbox-img" src="" alt="" class="w-full h-auto rounded-xl" />
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;

  if (dialog && lightboxImg) {
    document.querySelectorAll<HTMLButtonElement>('.lightbox-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        lightboxImg.src = btn.dataset.src ?? '';
        lightboxImg.alt = btn.getAttribute('aria-label') ?? '';
        dialog.showModal();
      });
    });

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

---
import { en as t } from '../i18n/en';

const base = import.meta.env.BASE_URL;
---

<section id="quickstart" class="py-20 px-4 border-t border-line bg-bg-raised">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="text-3xl sm:text-4xl font-semibold text-ink tracking-tight mb-4">{t.quickstartTitle}</h2>
    <p class="text-ink-dim leading-relaxed mb-8">{t.quickstartTeaserDesc}</p>
    <a
      href={`${base}/docs`}
      class="inline-flex items-center justify-center px-7 py-3.5 rounded-lg bg-accent hover:opacity-90 text-white font-semibold transition-opacity"
    >
      {t.quickstartTeaserCta}
    </a>
  </div>
</section>

---
import { en as t } from '../i18n/en';
---

<section class="py-20 px-4">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-14">
      <div class="font-mono text-xs font-medium tracking-[0.14em] uppercase text-accent mb-3">Architecture</div>
      <h2 class="text-3xl sm:text-4xl font-semibold text-ink tracking-tight">{t.architectureTitle}</h2>
    </div>
    <div class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-0">

      <!-- Sources -->
      <div class="flex flex-col gap-2 text-center">
        <div class="font-mono text-[11px] text-ink-mute mb-2 uppercase tracking-wide">Vulnerability Sources</div>
        {['NVD', 'OSV', 'CISA KEV', 'EPSS', 'Vendor Advisory'].map((src) => (
          <div class="px-3 py-1 rounded bg-bg-raised border border-line text-ink-dim text-sm">
            {src}
          </div>
        ))}
      </div>

      <!-- Arrow -->
      <div class="hidden md:flex items-center px-4 text-ink-mute">
        <svg class="w-8 h-4" viewBox="0 0 32 16" fill="none">
          <path d="M0 8h28M22 2l8 6-8 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="flex md:hidden text-ink-mute rotate-90">
        <svg class="w-8 h-4" viewBox="0 0 32 16" fill="none">
          <path d="M0 8h28M22 2l8 6-8 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <!-- API -->
      <div class="rounded-xl border-2 border-accent bg-accent-soft px-6 py-4 text-center min-w-32">
        <div class="text-accent font-mono font-semibold text-lg">heretix-api</div>
        <div class="text-ink-dim text-sm mt-1">Aggregation &amp; Search</div>
      </div>

      <!-- Arrow -->
      <div class="hidden md:flex items-center px-4 text-ink-mute">
        <svg class="w-8 h-4" viewBox="0 0 32 16" fill="none">
          <path d="M0 8h28M22 2l8 6-8 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="flex md:hidden text-ink-mute rotate-90">
        <svg class="w-8 h-4" viewBox="0 0 32 16" fill="none">
          <path d="M0 8h28M22 2l8 6-8 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <!-- Management -->
      <div class="rounded-xl border border-line bg-bg-raised px-6 py-4 text-center min-w-36">
        <div class="text-ink font-mono font-semibold text-lg">heretix-management</div>
        <div class="text-ink-dim text-sm mt-1">Web Console</div>
      </div>

      <!-- Double arrow (CLI feeds management) -->
      <div class="hidden md:flex items-center px-4 text-ink-mute">
        <svg class="w-8 h-4" viewBox="0 0 32 16" fill="none">
          <path d="M32 8H4M10 2L2 8l8 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="flex md:hidden text-ink-mute rotate-90">
        <svg class="w-8 h-4" viewBox="0 0 32 16" fill="none">
          <path d="M32 8H4M10 2L2 8l8 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <!-- CLI + Targets -->
      <div class="flex flex-col gap-2 text-center">
        <div class="rounded-xl border border-line bg-bg-raised px-6 py-4 text-center">
          <div class="text-ink font-mono font-semibold text-lg whitespace-nowrap">heretix-cli</div>
          <div class="text-ink-dim text-sm mt-1">Package Scanner</div>
        </div>
        <div class="font-mono text-[11px] text-ink-mute mt-2 uppercase tracking-wide">Targets</div>
        {['Linux Host', 'Windows Host', 'Docker Image'].map((target) => (
          <div class="px-3 py-1 rounded bg-bg-raised border border-line text-ink-dim text-sm whitespace-nowrap">
            {target}
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

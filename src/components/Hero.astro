---
import { en as t } from '../i18n/en';

// Background: a honeycomb echoing the logo, with a few cells tinted like the
// vulnerable nodes of the dependency graph. Cells sit on one lattice so the
// tinted ones line up with the pattern: row k, column n, pointy-top, radius R.
const R = 28;
const W = Math.sqrt(3) * R;
const center = (k: number, n: number): [number, number] => [n * W + (k % 2 === 0 ? W / 2 : 0), R + 1.5 * R * k];
const hexPoints = ([cx, cy]: [number, number]) =>
  [[0, -R], [W / 2, -R / 2], [W / 2, R / 2], [0, R], [-W / 2, R / 2], [-W / 2, -R / 2]]
    .map(([dx, dy]) => `${(cx + dx).toFixed(2)},${(cy + dy).toFixed(2)}`)
    .join(' ');
const tile = [center(0, 0), [0, 2.5 * R], [W, 2.5 * R], [0, -0.5 * R], [W, -0.5 * R]] as [number, number][];
const tinted = [[3, 4], [6, 2], [2, 25], [5, 23], [7, 27]].map(([k, n]) => hexPoints(center(k, n)));
---

<section class="relative overflow-hidden px-4 pt-32 pb-28">
  <div class="hero-glow absolute inset-0" aria-hidden="true"></div>
  <svg class="hero-grid absolute inset-0 h-full w-full" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
    <defs>
      <pattern id="hero-hex" width={W} height={3 * R} patternUnits="userSpaceOnUse">
        {tile.map((c) => <polygon points={hexPoints(c)} />)}
      </pattern>
    </defs>
    <rect width="1440" height="800" fill="url(#hero-hex)" />
    {tinted.map((points) => <polygon class="tinted" points={points} />)}
  </svg>
  <div class="relative max-w-3xl mx-auto text-center">
    <div class="font-mono text-xs font-medium tracking-[0.14em] uppercase text-accent mb-5">
      Open source &middot; Apache-2.0 &middot; Self-hosted
    </div>
    <h1 class="text-5xl sm:text-6xl md:text-7xl font-semibold leading-[1.1] tracking-tight text-ink mb-6">
      {t.heroTaglineLead}<span class="text-accent">{t.heroTaglineHighlight}</span>
    </h1>
    <p class="text-lg text-ink-dim mb-9 leading-relaxed max-w-2xl mx-auto">
      {t.heroDescription}
    </p>

    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href="#quickstart"
        class="px-7 py-3.5 rounded-lg bg-accent hover:opacity-90 text-white font-semibold transition-opacity"
      >
        {t.heroCTAPrimary}
      </a>
      <a
        href="https://github.com/TITeee/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-lg border border-line-strong hover:border-ink-mute text-ink-dim hover:text-ink font-mono text-sm transition-colors"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"/>
        </svg>
        {t.heroCTASecondary}
      </a>
    </div>
  </div>
</section>

<style>
  .hero-glow {
    background: radial-gradient(ellipse 65% 60% at 50% 0%, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 100%);
  }
  /* Strongest at the top centre, gone by the bottom edge so no seam shows above the stats band. */
  .hero-grid {
    -webkit-mask-image: radial-gradient(ellipse 75% 85% at 50% 15%, #000 0%, transparent 100%);
    mask-image: radial-gradient(ellipse 75% 85% at 50% 15%, #000 0%, transparent 100%);
  }
  .hero-grid polygon {
    fill: none;
    stroke: var(--color-line-strong);
    stroke-opacity: 0.18;
    stroke-width: 1;
  }
  .hero-grid .tinted {
    fill: var(--color-accent);
    fill-opacity: 0.05;
    stroke: var(--color-accent);
    stroke-opacity: 0.18;
  }
</style>

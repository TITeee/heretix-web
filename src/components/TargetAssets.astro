---
import { en as t } from '../i18n/en';

const rows = [
  { title: t.assetsNetworkTitle, desc: t.assetsNetworkDesc },
  { title: t.assetsOsTitle, desc: t.assetsOsDesc },
  { title: t.assetsMiddlewareTitle, desc: t.assetsMiddlewareDesc },
  { title: t.assetsPackagesTitle, desc: t.assetsPackagesDesc },
  { title: t.assetsContainerTitle, desc: t.assetsContainerDesc },
];

const cnaRow = { title: t.assetsCnaTitle, desc: t.assetsCnaDesc };

const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="py-20 px-4">
  <div class="max-w-4xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-9">
      <div>
        <div class="font-mono text-xs font-medium tracking-[0.14em] uppercase text-accent mb-3">Coverage</div>
        <h2 class="text-3xl sm:text-4xl font-semibold text-ink tracking-tight">{t.assetsTitle}</h2>
      </div>
      <p class="text-sm text-ink-dim leading-relaxed max-w-sm sm:text-right">{t.assetsSubtitle}</p>
    </div>

    <div class="border-t border-line">
      {rows.map((row, i) => (
        <div class="flex flex-col sm:flex-row gap-2 sm:gap-8 py-5 border-b border-line">
          <div class="sm:w-64 shrink-0 flex gap-3 items-baseline">
            <span class="font-mono text-xs text-ink-mute">{pad(i + 1)}</span>
            <span class="font-semibold text-ink">{row.title}</span>
          </div>
          <p class="flex-1 text-sm text-ink-dim leading-relaxed">{row.desc}</p>
        </div>
      ))}
      <div class="flex flex-col sm:flex-row gap-2 sm:gap-8 py-5 px-4 -mx-4 rounded-lg bg-accent-soft border-b border-line">
        <div class="sm:w-64 shrink-0 flex gap-3 items-baseline">
          <span class="font-mono text-xs text-accent">{pad(rows.length + 1)}</span>
          <span class="font-semibold text-ink">{cnaRow.title}</span>
        </div>
        <p class="flex-1 text-sm text-ink-dim leading-relaxed">{cnaRow.desc}</p>
      </div>
    </div>
  </div>
</section>

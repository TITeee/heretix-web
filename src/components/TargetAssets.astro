---
import { en as t } from '../i18n/en';

const groups = [
  {
    title: t.assetsNetworkTitle, desc: t.assetsNetworkDesc,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>`,
  },
  {
    title: t.assetsOsTitle, desc: t.assetsOsDesc,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" /></svg>`,
  },
  {
    title: t.assetsMiddlewareTitle, desc: t.assetsMiddlewareDesc,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605" /></svg>`,
  },
  {
    title: t.assetsPackagesTitle, desc: t.assetsPackagesDesc,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75 16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z" /></svg>`,
  },
  {
    title: t.assetsContainerTitle, desc: t.assetsContainerDesc,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6.878V6a2.25 2.25 0 0 1 2.25-2.25h7.5A2.25 2.25 0 0 1 18 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 0 0 4.5 9v.878m13.5-3A2.25 2.25 0 0 1 19.5 9v.878m0 0a2.246 2.246 0 0 0-.75-.128H5.25c-.263 0-.515.045-.75.128m15 0A2.25 2.25 0 0 1 21 12v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6c0-.98.626-1.813 1.5-2.122" /></svg>`,
  },
];

const cnaGroup = {
  title: t.assetsCnaTitle, desc: t.assetsCnaDesc,
  icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>`,
};
---

<section class="py-24 px-4">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-4xl sm:text-5xl font-bold text-white text-center mb-4">{t.assetsTitle}</h2>
    <p class="text-gray-400 text-center max-w-3xl mx-auto mb-16 leading-relaxed">{t.assetsSubtitle}</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
      {groups.map((g) => (
        <div class="rounded-xl border border-gray-800 bg-gray-900/50 p-6">
          <div class="mb-3 text-blue-400"><Fragment set:html={g.icon} /></div>
          <h3 class="font-semibold text-white mb-2">{g.title}</h3>
          <p class="text-gray-400 text-sm leading-relaxed">{g.desc}</p>
        </div>
      ))}
    </div>
    <div class="rounded-xl border border-amber-700/40 bg-amber-950/10 p-6">
      <div class="mb-3 text-amber-400"><Fragment set:html={cnaGroup.icon} /></div>
      <h3 class="font-semibold text-white mb-2">{cnaGroup.title}</h3>
      <p class="text-gray-400 text-sm leading-relaxed">{cnaGroup.desc}</p>
    </div>
  </div>
</section>

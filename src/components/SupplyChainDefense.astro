---
import { en as t } from '../i18n/en';

const detectors = [
  { code: 'T1', title: t.scGlasswormTitle, desc: t.scGlasswormDesc },
  { code: 'T2', title: t.scDepConfusionTitle, desc: t.scDepConfusionDesc },
  { code: 'T3', title: t.scInstallTitle, desc: t.scInstallDesc },
  { code: 'T4', title: t.scCicdTitle, desc: t.scCicdDesc },
  { code: 'T5', title: t.scSecretsTitle, desc: t.scSecretsDesc },
  { code: 'T6', title: t.scLockfileTitle, desc: t.scLockfileDesc },
];
---

<section class="py-20 px-4">
  <div class="max-w-5xl mx-auto">
    <div class="max-w-xl mb-9">
      <div class="font-mono text-xs font-medium tracking-[0.14em] uppercase text-danger mb-3">Supply chain</div>
      <h2 class="text-3xl sm:text-4xl font-semibold text-ink tracking-tight mb-4">{t.scTitle}</h2>
      <p class="text-sm text-ink-dim leading-relaxed">{t.scSubtitle}</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {detectors.map((d) => (
        <div class="rounded-lg border border-line bg-bg-raised p-5">
          <div class="font-mono text-[11px] text-danger mb-3">{d.code}</div>
          <h3 class="font-semibold text-ink mb-2">{d.title}</h3>
          <p class="text-ink-dim text-sm leading-relaxed">{d.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
